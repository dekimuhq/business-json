{
  "$ref": "#/definitions/BusinessVerifier",
  "definitions": {
    "BusinessVerifier": {
      "type": "object",
      "properties": {
        "businessVerifierVersion": {
          "type": "string",
          "const": "0.1"
        },
        "verifier": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^https:\\/\\/[\\x21-\\x7e]+$"
        },
        "keys": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kid": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[A-Za-z0-9._:-]+$"
              },
              "alg": {
                "type": "string",
                "const": "ed25519"
              },
              "x": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "notBefore": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              "notAfter": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              }
            },
            "required": [
              "kid",
              "alg",
              "x"
            ],
            "additionalProperties": false
          }
        },
        "lookup": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^https:\\/\\/[\\x21-\\x7e]+$"
        }
      },
      "required": [
        "businessVerifierVersion",
        "verifier",
        "keys"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
