{
  "$ref": "#/definitions/BindingRecord",
  "definitions": {
    "BindingRecord": {
      "type": "object",
      "properties": {
        "bindingRecordVersion": {
          "type": "string",
          "const": "0.1"
        },
        "verifier": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^https:\\/\\/[\\x21-\\x7e]+$"
        },
        "vat": {
          "type": "string",
          "pattern": "^(AT|BE|BG|CY|CZ|DE|DK|EE|EL|ES|FI|FR|HR|HU|IE|IT|LT|LU|LV|MT|NL|PL|PT|RO|SE|SI|SK|XI)[0-9A-Z+*]{2,12}$"
        },
        "level": {
          "type": "string",
          "const": "authority"
        },
        "authority": {
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "enum": [
                "qseal",
                "qes-representative"
              ]
            },
            "organizationIdentifier": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[^\\p{Cc}\\u202a-\\u202e\\u2066-\\u2069]+$"
            },
            "organizationName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "pattern": "^[^\\p{Cc}\\u202a-\\u202e\\u2066-\\u2069]+$"
            },
            "certificatePolicies": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[0-2](\\.(0|[1-9][0-9]*))+$"
              }
            },
            "certificateSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "certificateNotAfter": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            },
            "signedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            },
            "revocationCheckedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            },
            "trustedListSequence": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[^\\p{Cc}\\u202a-\\u202e\\u2066-\\u2069]+$"
            }
          },
          "required": [
            "method",
            "organizationIdentifier",
            "organizationName",
            "certificatePolicies",
            "certificateSha256",
            "certificateNotAfter",
            "signedAt",
            "revocationCheckedAt"
          ],
          "additionalProperties": false
        },
        "vies": {
          "type": "object",
          "properties": {
            "valid": {
              "type": "boolean",
              "const": true
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "pattern": "^[^\\p{Cc}\\u202a-\\u202e\\u2066-\\u2069]+$"
            },
            "address": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000,
              "pattern": "^[^\\p{Cc}\\u202a-\\u202e\\u2066-\\u2069]+$"
            },
            "checkedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            },
            "requestIdentifier": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[^\\p{Cc}\\u202a-\\u202e\\u2066-\\u2069]+$"
            }
          },
          "required": [
            "valid",
            "checkedAt"
          ],
          "additionalProperties": false
        },
        "domains": {
          "minItems": 1,
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "domain": {
                "type": "string",
                "maxLength": 253,
                "pattern": "^(?=.{1,253}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?$"
              },
              "dnsCheckedAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              "registeredAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              }
            },
            "required": [
              "domain",
              "dnsCheckedAt"
            ],
            "additionalProperties": false
          }
        },
        "profileDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "issuedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "sig": {
          "type": "object",
          "properties": {
            "alg": {
              "type": "string",
              "const": "ed25519"
            },
            "kid": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9._:-]+$"
            },
            "value": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$"
            }
          },
          "required": [
            "alg",
            "kid",
            "value"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "bindingRecordVersion",
        "verifier",
        "vat",
        "level",
        "authority",
        "domains",
        "profileDigest",
        "issuedAt",
        "expiresAt",
        "sig"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
